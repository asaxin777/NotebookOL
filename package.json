{
  "name": "noteisle",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:build": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --win portable",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:ci": "eslint && tsc --noEmit && vitest run && playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.noteisle.local",
    "productName": "NoteIsle",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.mjs",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "noteisle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "noteisle/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".desktop-build/node.exe",
        "to": "node.exe"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "NoteIsle-${version}-Windows-portable.${ext}"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
